# data.go.kr 일반 인증키 (Decoding) — 건축물대장/건축인허가/주택인허가 공통
# https://www.data.go.kr 에서 건축HUB 서비스 활용신청 후 발급
ARCHHUB_SERVICE_KEY=

# 전송 모드: stdio(로컬) | http(remote 커넥터). 기본 stdio
MCP_TRANSPORT=stdio
# http 모드 포트
PORT=8000

# (선택) 공용키 만료일 YYYY-MM-DD. 설정 시 /health가 만료 D-day·임박경고를 노출.
# ARCHHUB_KEY_EXPIRES=2028-06-02

# (선택·운영 권장) 공개 remote 보호. 설정 시 /mcp 접근에 'Authorization: Bearer <값>' 요구.
# 미설정이면 무인증(로컬 stdio 등 신뢰 환경). fly는 `fly secrets set ARCHHUB_MCP_TOKEN=...`.
# ARCHHUB_MCP_TOKEN=

# (선택·운영 권장) 공용키 일일 호출 캡. 0/미설정이면 미적용. 키 한도에 맞춰 설정.
# ARCHHUB_DAILY_CALL_CAP=0

# (선택) 법정동코드 캐시 디렉토리. 기본 ~/.cache/archhub-mcp
# ARCHHUB_CACHE_DIR=
